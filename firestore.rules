rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // no broad listing of user accounts
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollection: Saved Jobs
      match /savedJobs/{jobId} {
        allow read, write: if isOwner(userId) && isValidId(jobId);
      }

      // Subcollection: Chat Messages
      match /chatMessages/{messageId} {
        allow read, write: if isOwner(userId) && isValidId(messageId);
      }

      // Subcollection: Interview Sessions
      match /interviewSessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);
      }

      // Subcollection: Badges & Virtual Credentials
      match /badges/{badgeId} {
        allow read, write: if isOwner(userId) && isValidId(badgeId);
      }
    }
  }
}
